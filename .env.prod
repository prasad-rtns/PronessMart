STACK_NAME=services-integration
SERVER_HOST=172.20.104.100
DEPLOY_ROOT=/tmp/services-integration

REDIS_IMAGE=redis:7-alpine
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.5.0
KAFKA_IMAGE=confluentinc/cp-kafka:7.5.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:10.4.6
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:latest

REDIS_PORT=6379
ZOOKEEPER_PORT=2181
KAFKA_1_PORT=9092
KAFKA_2_PORT=9093
KAFKA_3_PORT=9094
KAFKA_UI_PORT=8090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8081

KAFKA_UI_BASE_PATH=/kafka
PROMETHEUS_BASE_PATH=/prometheus
GRAFANA_BASE_PATH=/grafana

KAFKA_HEAP_OPTS="-Xms512M -Xmx1G"

PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
